# Copy to .env and fill in real values. Do not commit .env.

# --- Service ---
OCIANA_CHATBOT_HOST=0.0.0.0
OCIANA_CHATBOT_PORT=8080
OCIANA_CHATBOT_LOG_LEVEL=INFO
# Shared secret Ociana / n8n must send as header X-Api-Key
OCIANA_CHATBOT_API_KEY=change-me

# --- Jira Cloud ---
# Example base: https://your-org.atlassian.net
JIRA_BASE_URL=
JIRA_EMAIL=
# Atlassian API token (https://id.atlassian.com/manage-profile/security/api-tokens)
JIRA_API_TOKEN=
# Fallback project key when no project is detected from the message
JIRA_DEFAULT_PROJECT_KEY=SUP
# Issue type name used when creating tickets (usually "Task" or "Bug" or "Support")
JIRA_ISSUE_TYPE=Task
# Dry-run: do not call Jira; return a fake ticket key (useful for local demo)
JIRA_DRY_RUN=true

# --- Optional Claude for smarter intent + ticket summaries ---
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-3-5-sonnet-latest
USE_CLAUDE_CLASSIFIER=false

# Path to project mapping JSON (defaults to config/project_map.json)
PROJECT_MAP_PATH=config/project_map.json
