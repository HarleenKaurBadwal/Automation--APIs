FROM n8nio/n8n:latest

USER root

RUN apk add --no-cache python3 py3-pip

WORKDIR /workspace
COPY requirements.txt /workspace/requirements.txt

RUN python3 -m venv /opt/automation-venv \
    && /opt/automation-venv/bin/pip install --no-cache-dir --upgrade pip \
    && /opt/automation-venv/bin/pip install --no-cache-dir -r /workspace/requirements.txt

ENV PATH="/opt/automation-venv/bin:${PATH}"

USER node
