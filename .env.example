# Copy this file to .env in your n8n/Python runtime and fill in real values.
# Do not commit .env.

# The command that runs your existing Aha + GitLab + QuickBooks report script.
# The runner replaces these placeholders before executing the command:
#   {input_csv}   - CSV uploaded to the n8n webhook
#   {output_xlsx} - Excel file path n8n will upload to OneDrive
#   {workdir}     - working directory for temporary files
REPORT_COMMAND=python3 scripts/your_existing_report.py --input-csv {input_csv} --output-xlsx {output_xlsx}
REPORT_WORKDIR=/tmp/n8n-reports
LOG_LEVEL=INFO

# Existing API credentials used by your report script.
AHA_API_URL=
AHA_API_TOKEN=
GITLAB_API_URL=https://gitlab.com/api/v4
GITLAB_API_TOKEN=
QUICKBOOKS_CLIENT_ID=
QUICKBOOKS_CLIENT_SECRET=
QUICKBOOKS_REALM_ID=
QUICKBOOKS_REFRESH_TOKEN=

# Future Claude step. Leave unused until the Claude node/API call is added.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-3-5-sonnet-latest

# n8n/OneDrive setup notes:
# Configure Microsoft OneDrive OAuth credentials directly in n8n.
# Set the OneDrive node's parent folder to the folder where reports should land.
